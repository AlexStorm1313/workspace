# Rules formerly in infrastructure/.gitignore, scoped to that directory.
# Generated by MacOS
infrastructure/**/.DS_Store

# Generated by Windows
infrastructure/**/Thumbs.db

# Common backup files
infrastructure/**/*.swp
infrastructure/**/*.bak
infrastructure/**/*.tmp
infrastructure/**/*.orig
infrastructure/**/*~

# Various IDEs
infrastructure/**/.project
infrastructure/**/.idea/
infrastructure/**/*.tmproj
infrastructure/**/.vscode/

# Deployment
infrastructure/secrets/*
!infrastructure/secrets/.gitkeep
infrastructure/templates/secrets/*.yaml
infrastructure/templates/secrets/hermes/hermes.yaml
infrastructure/kube.yaml

# Certificates
infrastructure/**/*.crt
