FROM quay.io/fedora/fedora:latest

ARG USER=core
ARG UID=1001
ARG GID=0
ARG HOME=/home/${USER}

LABEL name="AlexStorm1313/core" \
    vendor="AlexStorm1313" \
    version="0.0.1" \
    release="1" \
    summary="Container image used as a base layer" \
    description="Container image used as a base layer"

# Set ENV variables
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV HOME=${HOME}
ENV SHELL=/bin/bash
ENV PATH=${HOME}/.cargo/bin:${HOME}/.bun/bin:${HOME}/.local/bin:${PATH}
ENV HERMES_RUNTIME_DIR=/opt/hermes/tools

RUN groupadd -g ${UID} ${USER} && \
    useradd -u ${UID} -g ${UID} -m -s $SHELL ${USER} && \
    chown -R "${UID}:${GID}" "${HOME}" && \
    chmod -R g=u "${HOME}"

# Bootstrap the RPM repositories; the download cache is not part of the image.
RUN --mount=type=cache,id=core-dnf5,target=/var/cache/libdnf5 \
    curl -fsSL https://s3.amazonaws.com/session-manager-downloads/plugin/latest/linux_64bit/session-manager-plugin.rpm -o session-manager-plugin.rpm && \
    dnf -y --setopt=keepcache=1 install ./session-manager-plugin.rpm && \
    rm -f ./session-manager-plugin.rpm && \
    # Register all repos first
    # curl -fsSL https://rpm.releases.hashicorp.com/fedora/hashicorp.repo -o /etc/yum.repos.d/hashicorp.repo && \
    dnf -y --setopt=keepcache=1 install dnf-plugins-core \
    "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
    "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"

# Update Fedora, then enable COPR and install the system packages.
RUN --mount=type=cache,id=core-dnf5,target=/var/cache/libdnf5 \
    dnf -y --setopt=keepcache=1 update && \
    dnf -y --setopt=keepcache=1 copr enable atim/starship && \
    dnf -y --setopt=keepcache=1 install \
    awk \
    awscli2 \
    azure-cli \
    bash-completion \
    composer \
    fira-code-fonts \
    gcc \
    git \
    hostname \
    libpq-devel \
    nodejs \
    npm \
    oci-cli \
    openssh-server \
    opentofu \
    php \
    podman \
    procps \
    rsync \
    rustup \
    starship \
    # terraform-ls \
    tini \
    unzip \
    uv \
    which

# Install home-directory tools as the runtime user, with group access for GID 0.
USER ${UID}:${GID}

# Keep the toolchain and installed binaries, but not Cargo's download caches.
RUN umask 0002 && \
    rustup-init -y --profile=default --default-toolchain=nightly && \
    chmod -R g=u "${HOME}/.rustup" "${HOME}/.cargo"
RUN --mount=type=cache,id=core-cargo-registry-user,target=${HOME}/.cargo/registry,uid=${UID},gid=${GID} \
    --mount=type=cache,id=core-cargo-git-user,target=${HOME}/.cargo/git,uid=${UID},gid=${GID} \
    umask 0002 && \
    cargo install --locked watchexec-cli && \
    cargo install --locked bacon && \
    cargo install --locked diesel_cli --no-default-features --features "postgres" && \
    cargo install --locked cargo-lambda

# Install Bun and OpenCode in separate layers. Keep Bun's downloads out of the image.
RUN umask 0002 && \
    bash -o pipefail -c 'curl -fsSL https://bun.sh/install | sh' && \
    chmod -R g=u "${HOME}/.bun"
RUN --mount=type=cache,id=core-bun-user,target=/var/cache/bun,uid=${UID},gid=${GID} \
    umask 0002 && \
    BUN_INSTALL_CACHE_DIR=/var/cache/bun bun install -g --trust @opencode/cli && \
    chmod -R g=u "${HOME}/.bun/install/global"

# Install additional coding agents into the runtime user's home.
RUN umask 0002 && \
    bash -o pipefail -c 'curl -fsSL https://t3.codes/install.sh | sh'
RUN umask 0002 && \
    bash -o pipefail -c 'curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh'
RUN umask 0002 && \
    bash -o pipefail -c 'curl -fsSL https://claude.ai/install.sh | bash'

# Install shared agent skills without interactive prompts.
RUN umask 0002 && npx --yes skills add juliobsz/skills --global --agent universal --skill '*' --yes
RUN umask 0002 && npx --yes skills add payloadcms/skills --global --agent universal --skill '*' --yes
RUN umask 0002 && npx --yes skills add https://github.com/anthropics/skills --global --agent universal --skill frontend-design --yes

# SHELL setup
RUN echo 'alias opencode="bunx --bun opencode"' >> ${HOME}/.bashrc
RUN echo 'eval "$(starship init bash)"' >> ${HOME}/.bashrc

# Set fixed non-root user for compatibility with Podman/Docker and Kubernetes
USER ${UID}
WORKDIR ${HOME}
